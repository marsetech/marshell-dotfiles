/*****
──── Element list ─────────────────────────────────────────────────
*****/
element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @active-background;
    background-color:            transparent;
    text-color:                  @foreground;
    orientation:                 horizontal;
    cursor:                      pointer;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}
element selected.normal {
    border-radius:               10px;
    background-color:            @active-background;
    text-color:                  @background;
}

/*****
──── Element Icons ─────────────────────────────────────────────────
*****/
element-icon {
    padding:                     10px;
    border-radius:               100%;
    background-color:            @background;
    text-color:                  inherit;
    size:                        24px;
    cursor:                      inherit;
}
element-icon selected.normal {
    background-color:            @active-background;
}
