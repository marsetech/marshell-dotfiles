{
  "position": "top",
  "margin-top": 6,
  "margin-bottom": 3,
  "include": [
    "$HOME/.config/waybar/modules/*.jsonc",
    "$HOME/.config/waybar/modules/**/*.jsonc",
  ],
  "modules-left": ["clock", "mpris"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "custom/updates",
    "pulseaudio",
    "network",
    "custom/notification",
  ],
}
