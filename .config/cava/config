## CAVA configuration file
## Remove the ";" to activate a parameter.

# =============================================================================
# [general] — sensitivity, bar layout, frequency range
# =============================================================================
[general]
; live-config = 0        # auto-reload config on change
; mode = normal           # 'normal', 'scientific' or 'waves' (deprecated)
; framerate = 60
; sleep_timer = 0         # seconds of silence before sleep mode, 0 = disable

; autosens = 1            # auto-lower sensitivity if bars peak
; overshoot = 20          # % overshoot allowed before autosens (deprecated)
; sensitivity = 100       # manual sensitivity %, 200 = double height

; bars = 0                # number of bars, 0 = auto-fill
; bar_width = 2
; bar_spacing = 1
; bar_height = 32         # only for "noritake" output

; center_align = 1
; max_height = 100        # % of terminal height

; lower_cutoff_freq = 50
; higher_cutoff_freq = 10000


# =============================================================================
# [input] — audio capture method and device
# =============================================================================
[input]
# method: fifo, portaudio, pipewire, alsa, pulse, sndio, oss, jack, shmem
# 'source' meaning depends on the method (device path, source name, etc.)

; method = pulse
; source = auto

; method = pipewire
; source = auto

; method = alsa
; source = hw:Loopback,1

; method = fifo
; source = /tmp/mpd.fifo

; method = shmem
; source = /squeezelite-AA:BB:CC:DD:EE:FF

; method = portaudio
; source = auto

; method = sndio
; source = default

; method = oss
; source = /dev/dsp

; method = jack
; source = default

; sample_rate = 44100
; sample_bits = 16
; channels = 2
; autoconnect = 2

; active = 1              # pipewire: keep node always processing
; remix = 1                # pipewire: let it remix channels
; virtual = 1              # pipewire: mark node as virtual


# =============================================================================
# [output] — rendering method, orientation, raw/SDL options
# =============================================================================
[output]
; method = noncurses      # ncurses, noncurses, raw, noritake, sdl, sdl_glsl

; orientation = bottom    # bottom, top, left, right, horizontal
; channels = stereo       # stereo or mono
; mono_option = average   # left, right, average
; reverse = 0

; horizontal_stereo = 0   # only used when orientation = horizontal
; left_bottom = 1

; raw_target = /dev/stdout
; data_format = binary    # binary or ascii
; bit_format = 16bit      # 8bit or 16bit
; ascii_max_range = 1000
; bar_delimiter = 59
; frame_delimiter = 10

; sdl_width = 1024
; sdl_height = 512
; sdl_x = -1
; sdl_y = -1
; sdl_full_screen = 0

; xaxis = none            # 'frequency' or 'none'
; synchronized_sync = 0   # fixes flicker in Alacritty

; vertex_shader = pass_through.vert
; fragment_shader = bar_spectrum.frag
; continuous_rendering = 0

; disable_blanking = 0
; show_idle_bar_heads = 1
; waveform = 0


# =============================================================================
# [color]
# =============================================================================
[color]
# Require both vertical and horizontal gradient enabled.
; blend_direction = 'up'    # left, right, up, down

theme = 'pywal'


# =============================================================================
# [smoothing]
# =============================================================================
[smoothing]
; integral = 77           # deprecated, use noise_reduction
; monstercat = 0
; waves = 0
; gravity = 100           # deprecated, use noise_reduction
; ignore = 0               # deprecated
; noise_reduction = 77    # 0 = fast/noisy, 100 = slow/smooth


# =============================================================================
# [eq] — per-band equalizer, add as many keys as needed
# =============================================================================
[eq]
; 1 = 1 # bass
; 2 = 1
; 3 = 1 # midtone
; 4 = 1
; 5 = 1 # treble
